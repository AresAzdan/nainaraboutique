# Server
PORT=3000
NODE_ENV=production

# Frontend (your Vercel URL)
FRONTEND_URL=https://nainaraboutique.vercel.app

# Database — replace these with your Railway PostgreSQL values
# Find them in Railway → Postgres service → Variables tab
DB_HOST=your_railway_pghost
DB_PORT=5432
DB_NAME=your_railway_pgdatabase
DB_USER=your_railway_pguser
DB_PASSWORD=your_railway_pgpassword

# JWT — generate a real secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

